mm_ae_mac: mm_ae_mac {
    compatible = "zmk,behavior-mod-morph";
    #binding-cells = <0>;
    bindings = <&mac_ae>, <&mac_AE>;
    mods = <(MOD_LSFT|MOD_RSFT)>;
};
