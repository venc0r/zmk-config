    tap-ms = <30>;
    bindings = <&kp LS(SQT)>, <&kp U>;
};
lin_sz: lin_sz {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    bindings = <&kp RA(S)>;
};
mac_ae_up: mac_ae_up {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    wait-ms = <30>;
    tap-ms = <30>;
    bindings = <&kp LA(U)>, <&kp LS(A)>;
};
mac_oe_up: mac_oe_up {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    wait-ms = <30>;
    tap-ms = <30>;
    bindings = <&kp LA(U)>, <&kp LS(O)>;
